<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/nearly_widget_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_l1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nly_ink"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_l2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nly_ink"
            android:textSize="14sp"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_l3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nly_mu"
            android:textSize="13sp"
            android:maxLines="2"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/w_heart"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:padding="17dp"
        android:src="@drawable/ic_nearly_heart"
        android:background="@drawable/nearly_heart_btn"
        android:contentDescription="Send a heart"/>
</LinearLayout>
