<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView android:id="@+id/w_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="11sp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView android:id="@+id/w_big" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:maxLines="6" android:ellipsize="end" android:textSize="16sp"/>
            <ImageView android:id="@+id/w_hw" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="Handwritten message"/>
        </FrameLayout>

        <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="12sp"/>

        <LinearLayout
            android:id="@+id/w_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/w_b1" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="2"
                android:layout_marginEnd="4dp" android:gravity="center" android:maxLines="1" android:background="@drawable/nly_btn_bg"/>
            <TextView android:id="@+id/w_b2" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
                android:layout_marginEnd="4dp" android:gravity="center" android:maxLines="1" android:background="@drawable/nly_btn_bg"/>
            <TextView android:id="@+id/w_b3" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
                android:gravity="center" android:maxLines="1" android:background="@drawable/nly_btn_bg"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
